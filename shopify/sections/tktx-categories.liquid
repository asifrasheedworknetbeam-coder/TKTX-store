{{ 'footer-finish.css' | asset_url | stylesheet_tag }}
{% comment %}White TKTX category presentation. The default single-product concept can be expanded with collection blocks.{% endcomment %}
<style>
@font-face{font-family:TKTXAnton;src:url('{{ 'anton.ttf' | asset_url }}') format('truetype');font-weight:400;font-display:swap}
@font-face{font-family:TKTXMono;src:url('{{ 'roboto-mono.ttf' | asset_url }}') format('truetype');font-weight:500;font-display:swap}
.tktx-store{--ink:#000000;--gutter:2.45vw;--content-max:1400px;--ease:cubic-bezier(.22,1,.36,1);font-family:Arial,Helvetica,sans-serif}
.tktx-store *{box-sizing:border-box}
.tktx-store a{color:inherit;text-decoration:none}

/* White collection section — shares the banner's typography and 1400px grid. */
.tktx-store .collection-section{background:#ffffff;color:var(--ink);padding:82px 0 94px;scroll-margin-top:24px}
.tktx-store .collection-container{width:calc(100% - 2 * var(--gutter));max-width:var(--content-max,1400px);margin:0 auto}
.tktx-store .collection-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:28px;padding-bottom:28px;border-bottom:1px solid #0000001c}
.tktx-store .collection-eyebrow{margin:0 0 15px;font:500 9px/1.5 TKTXMono,monospace;letter-spacing:.17em;color:#707070}
.tktx-store .collection-heading h2{margin:0;color:var(--ink);font:400 clamp(36px,4.2vw,60px)/1.1 TKTXAnton,Impact,sans-serif;letter-spacing:-.025em}
.tktx-store .collection-all{display:inline-flex;align-items:center;gap:28px;padding:9px 0;font-size:12px;font-weight:600;white-space:nowrap;border-bottom:1px solid #000000;transition:opacity .25s}
.tktx-store .collection-all:hover{opacity:.55}
.tktx-store .collection-all span{font-size:20px;font-weight:400;line-height:1}
.tktx-store .category-grid{display:flex;justify-content:center;padding-top:32px}
.tktx-store .category-product{display:block;width:min(400px,100%);text-align:center}
.tktx-store .category-product figure{margin:0}
.tktx-store .category-product-stage{display:grid;place-items:center;height:350px;background:#ffffff}
.tktx-store .category-product-stage img{display:block;width:350px;max-width:100%;height:auto;aspect-ratio:1;object-fit:contain;transition:transform .7s var(--ease)}
.tktx-store .category-product:hover .category-product-stage img{transform:translateY(-7px) rotate(-2deg)}
.tktx-store .category-product figcaption{padding:20px 20px 0}
.tktx-store .category-type{display:block;margin-bottom:10px;font:500 9px/1.5 TKTXMono,monospace;letter-spacing:.18em;color:#707070}
.tktx-store .category-product h3{display:inline-flex;align-items:center;gap:18px;margin:0;color:var(--ink);font:400 27px/1.2 TKTXAnton,Impact,sans-serif;letter-spacing:-.015em}
.tktx-store .category-arrow{display:grid;place-items:center;width:27px;height:27px;border:1px solid #00000033;border-radius:50%;font:400 17px/1 Arial,sans-serif;transition:background .3s,color .3s,transform .3s}
.tktx-store .category-product:hover .category-arrow{background:var(--ink);color:#ffffff;transform:rotate(5deg)}
.tktx-store .collection-section a:focus-visible{outline:2px solid var(--ink)}
@media(max-width:760px){
 .tktx-store .collection-section{padding:54px 0 64px}
 .tktx-store .collection-heading{align-items:flex-start;gap:20px;padding-bottom:24px;flex-direction:column}
 .tktx-store .collection-eyebrow{font-size:8px;margin-bottom:12px}
 .tktx-store .collection-heading h2{font-size:clamp(32px,8.7vw,48px)}
 .tktx-store .collection-all{font-size:11px;gap:20px}
 .tktx-store .category-grid{padding-top:24px}
 .tktx-store .category-product-stage{height:300px}
 .tktx-store .category-product-stage img{width:300px}
 .tktx-store .category-product figcaption{padding-top:14px}
 .tktx-store .category-product h3{font-size:25px}
}


/* Three full cards with the next card exposed past the right container edge. */
.tktx-store .collection-section{overflow:hidden}
.tktx-store .collection-container{--category-gap:28px;--category-content:min(var(--content-max,1400px),calc(100vw - 2 * var(--gutter)));--category-width:calc((var(--category-content) - 3 * var(--category-gap)) / 3.18)}
.tktx-store .collection-heading-actions{display:flex;align-items:center;gap:32px}
.tktx-store .category-controls{display:flex;gap:8px}
.tktx-store .category-control{display:grid;place-items:center;width:40px;height:40px;padding:0;border:1px solid #00000040;border-radius:50%;background:#ffffff;color:var(--ink);cursor:pointer;transition:background .25s,color .25s}
.tktx-store .category-control:hover{background:var(--ink);color:#ffffff}
.tktx-store .category-control svg{width:17px;height:17px}
.tktx-store .category-control:focus-visible{outline:2px solid var(--ink);outline-offset:4px}
.tktx-store .category-viewport{width:calc(100% + max(var(--gutter),calc((100vw - var(--content-max,1400px)) / 2)));max-width:calc(4 * var(--category-width) + 3 * var(--category-gap));overflow:hidden;padding-top:32px;touch-action:pan-y;cursor:grab}
.tktx-store .category-viewport:active{cursor:grabbing}
.tktx-store .category-track{display:flex;align-items:flex-start;gap:var(--category-gap);width:100%;transition:transform .65s var(--ease);will-change:transform}
.tktx-store .category-track .category-product{width:var(--category-width);flex:0 0 var(--category-width);min-width:0;user-select:none}
.tktx-store .category-track .category-product-stage{height:auto;aspect-ratio:1}
.tktx-store .category-track .category-product-stage img{width:100%;height:100%;max-height:370px;pointer-events:none}
.tktx-store .category-track .category-product figcaption{padding-top:16px}
.tktx-store .category-track .category-product h3{font-size:26px}
@media(max-width:1000px){.tktx-store .collection-container{--category-gap:22px;--category-width:calc((var(--category-content) - 2 * var(--category-gap)) / 2.15)}}
@media(max-width:760px){
 .tktx-store .collection-container{--category-gap:18px;--category-width:calc((var(--category-content) - var(--category-gap)) / 1.18)}
 .tktx-store .collection-heading-actions{width:100%;justify-content:space-between;gap:16px}
 .tktx-store .category-control{width:36px;height:36px}
 .tktx-store .category-viewport{padding-top:24px}
 .tktx-store .category-track .category-product h3{font-size:25px}
}
@media(prefers-reduced-motion:reduce){.tktx-store .category-track{transition:none}}

</style>
<div class="tktx-store">
  <section class="collection-section" id="categories-{{ section.id }}" aria-labelledby="collection-title-{{ section.id }}" data-category-carousel aria-roledescription="carousel">
    <div class="collection-container">
      <header class="collection-heading">
        <div><p class="collection-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="collection-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
        <div class="collection-heading-actions"><a class="collection-all" href="{{ section.settings.all_link | default: routes.all_products_collection_url }}">Explore all products <span aria-hidden="true">↗</span></a><div class="category-controls" aria-label="Category slider controls">
              <button class="category-control category-prev" type="button" aria-label="Previous category"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m14 5-7 7 7 7M7 12h14"/></svg></button>
              <button class="category-control category-next" type="button" aria-label="Next category"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m10 5 7 7-7 7M17 12H3"/></svg></button>
            </div></div>
      </header>
      <div class="category-viewport"><div class="category-track">
        {% for block in section.blocks %}
          {% liquid
            assign item_collection = block.settings.collection
            assign item_product = block.settings.product
            assign item_image = block.settings.image | default: item_collection.image | default: item_product.featured_image
            assign item_title = block.settings.title | default: item_collection.title | default: item_product.title | default: 'TKTX GOLD'
            assign item_link = block.settings.link | default: item_collection.url | default: item_product.url | default: routes.all_products_collection_url
          %}
          <a class="category-product" href="{{ item_link }}" {{ block.shopify_attributes }}>
            <figure>
              <div class="category-product-stage">
                {% if item_image != blank %}
                  {{ item_image | image_url: width: 900 | image_tag: widths: '300,450,600,900', sizes: '(max-width: 760px) 44vw, 350px', loading: 'lazy', alt: item_title }}
                {% else %}
                  <img src="{{ 'tktx-gold-studio.png' | asset_url }}" width="1254" height="1254" loading="lazy" alt="TKTX Gold studio product concept">
                {% endif %}
              </div>
              <figcaption><span class="category-type">{{ block.settings.caption | escape }}</span><h3>{{ item_title | escape }}<span class="category-arrow" aria-hidden="true">↗</span></h3></figcaption>
            </figure>
          </a>
        {% endfor %}
      </div></div>
    </div>
  </section>
</div>
<script src="{{ 'category-slider.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "TKTX categories",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small introduction",
      "default": "01 / THE ORIGINAL COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY CATEGORY."
    },
    {
      "type": "url",
      "id": "all_link",
      "label": "All products link"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product (optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom studio image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom display name"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Small category label",
          "default": "NUMBING CREAM"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "TKTX categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "TKTX GOLD",
            "caption": "NUMBING CREAM"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "TKTX GOLD",
            "caption": "NUMBING CREAM"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "TKTX GOLD",
            "caption": "NUMBING CREAM"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "TKTX GOLD",
            "caption": "NUMBING CREAM"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "TKTX GOLD",
            "caption": "NUMBING CREAM"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "TKTX GOLD",
            "caption": "NUMBING CREAM"
          }
        }
      ]
    }
  ]
}
{% endschema %}
